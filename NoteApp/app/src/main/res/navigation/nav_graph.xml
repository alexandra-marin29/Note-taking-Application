<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- LoginFragment -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.noteapp.fragments.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_foldersFragment"
            app:destination="@id/foldersFragment" />

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- RegisterFragment -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.noteapp.fragments.RegisterFragment"
        android:label="Register">

        <action
            android:id="@+id/action_registerFragment_to_foldersFragment"
            app:destination="@id/foldersFragment" />
    </fragment>

    <!-- FoldersFragment -->
    <fragment
        android:id="@+id/foldersFragment"
        android:name="com.example.noteapp.fragments.FoldersFragment"
        android:label="Folders">

        <action
            android:id="@+id/action_foldersFragment_to_homeFragment"
            app:destination="@id/homeFragment">
            <argument
                android:name="folderId"
                app:argType="integer"
                android:defaultValue="1" />
        </action>


        <action
            android:id="@+id/action_foldersFragment_to_addNoteFragment"
            app:destination="@id/addNoteFragment">
            <argument
                android:name="folderId"
                app:argType="integer"
                android:defaultValue="1" />
        </action>


        <action
            android:id="@+id/action_foldersFragment_to_checkListFragment"
            app:destination="@id/checkListFragment">
            <argument
                android:name="folderId"
                app:argType="integer"
                android:defaultValue="1" />
            <argument
                android:name="note"
                app:argType="com.example.noteapp.model.Note"
                app:nullable="true" />
        </action>

        <action
            android:id="@+id/action_foldersFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- HomeFragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.noteapp.fragments.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />


        <action
            android:id="@+id/action_homeFragment_to_addNoteFragment"
            app:destination="@id/addNoteFragment">
            <argument
                android:name="folderId"
                app:argType="integer" />
        </action>


        <action
            android:id="@+id/action_homeFragment_to_checkListFragment"
            app:destination="@id/checkListFragment">
            <argument
                android:name="folderId"
                app:argType="integer" />
            <argument
                android:name="note"
                app:argType="com.example.noteapp.model.Note"
                app:nullable="true" />
        </action>
        <action
            android:id="@+id/action_homeFragment_to_editNoteFragment"
            app:destination="@id/editNoteFragment">
            <argument
                android:name="note"
                app:argType="com.example.noteapp.model.Note"
                app:nullable="true" />
        </action>
    </fragment>

    <!-- AddNoteFragment -->
    <fragment
        android:id="@+id/addNoteFragment"
        android:name="com.example.noteapp.fragments.AddNoteFragment"
        android:label="Add Note">
    </fragment>

    <!-- CheckListFragment -->
    <fragment
        android:id="@+id/checkListFragment"
        android:name="com.example.noteapp.fragments.CheckListFragment"
        android:label="Checklist">
    </fragment>

    <!-- EditNoteFragment -->
    <fragment
        android:id="@+id/editNoteFragment"
        android:name="com.example.noteapp.fragments.EditNoteFragment"
        android:label="Edit Note">
        <argument
            android:name="note"
            app:argType="com.example.noteapp.model.Note"
            app:nullable="true" />
    </fragment>
</navigation>
