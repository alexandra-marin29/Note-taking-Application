<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:cardCornerRadius="10dp"
        app:cardUseCompatPadding="true"
        android:padding="12dp"
        tools:context=".fragments.CheckListFragment">

        <LinearLayout
            android:id="@+id/checklistRootLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/gray_border"
            android:padding="12dp">

            <TextView
                android:id="@+id/checklistHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Checklist Note"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/checklistTitle"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:hint="Enter the title"
                android:maxLines="1"
                android:padding="12dp"
                android:textSize="20sp"
                android:background="@drawable/gray_border" />

            <TextView
                android:id="@+id/checklistDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="@color/dark_gray"
                android:fontFamily="@font/poppins"
                android:text=""/>

            <LinearLayout
                android:id="@+id/checkListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
